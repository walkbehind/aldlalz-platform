  "legal": {
    "terms": {
      "title": "شروط الاستخدام",
      "updated": "آخر تحديث: يونيو 2026",
      "s1Title": "1. القبول",
      "s1Body": "باستخدام الدلالز فإنك توافق على هذه الشروط. إذا لم توافق، لا تستخدم المنصة.",
      "s2Title": "2. الإعلانات والمحتوى",
      "s2Body": "أنت مسؤول عن دقة إعلاناتك. قد تراجع الدلالز أو تعتمد أو تزيل المحتوى المخالف للشروط أو القانون الكويتي.",
      "s3Title": "3. الحسابات",
      "s3Body": "يجب تقديم معلومات تسجيل صحيحة والحفاظ على سرية بيانات الدخول. أنت مسؤول عن النشاط تحت حسابك.",
      "s4Title": "4. الاشتراكات والرسوم",
      "s4Body": "تطبق الباقات المدفوعة وحدود الإعلانات كما هو موضح في صفحة الباقات. قد تتغير الرسوم بإشعار مسبق.",
      "s5Title": "5. التواصل",
      "s5Body": "استفسارات حول الشروط: info@aldlalz.com"
    },
    "privacy": {
      "title": "سياسة الخصوصية",
      "updated": "آخر تحديث: يونيو 2026",
      "s1Title": "1. البيانات التي نجمعها",
      "s1Body": "نجمع معلومات الحساب (البريد، الاسم، الجوال) ومحتوى الإعلانات وبيانات الاستخدام اللازمة لتشغيل المنصة.",
      "s2Title": "2. كيف نستخدم البيانات",
      "s2Body": "تُستخدم البيانات لتقديم الخدمة وتمكين التواصل بين البائع والمشتري ومعالجة الاشتراكات وتحسين المنصة.",
      "s3Title": "3. المشاركة",
      "s3Body": "يظهر رقم جوالك وتفاصيل إعلانك للمشترين في الإعلانات المعتمدة. لا نبيع بياناتك الشخصية لأطراف ثالثة.",
      "s4Title": "4. الأمان",
      "s4Body": "نطبق إجراءات أمان معيارية لحماية بياناتك. لا توجد طريقة نقل عبر الإنترنت آمنة بنسبة 100%.",
      "s5Title": "5. حقوقك",
      "s5Body": "يمكنك تحديث ملفك أو طلب حذف الحساب عبر info@aldlalz.com"
    }
  },
